// $conf['vfs']['params']['vfsroot'] = '/tmp';
$conf['vfs']['type'] = 'horde';

// ----------------------------------------------------------------------
// Fax Driver Settings
// ----------------------------------------------------------------------
// What Fax driver should we use? ('hylafax' = Hylafax, 'spandsp' = Asterisk w/ SpanDSP)
$conf['fax']['driver'] = 'hylafax';
// Where are located Hylafax binaries?
$conf['fax']['params']['base_path'] = '/usr/sbin';
// Where is located the 'faxrcvd' binary?
$conf['fax']['faxrcvd'] = '/var/spool/hylafax/bin';
